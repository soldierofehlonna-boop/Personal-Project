# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Local scratch files used during a session (proposed state drafts, etc.)
*.tmp

# Keep backups out of version control noise unless explicitly wanted --
# comment this out if you'd rather track backup snapshots in git too.
eldara/saves/backups/*.json
!eldara/saves/backups/.gitkeep

# Exported save bundles (scripts/export_save.py) are point-in-time
# snapshots meant to be handed off or archived outside the repo, not
# tracked as repo history -- same reasoning as saves/backups/ above.
eldara/saves/exports/*.json
!eldara/saves/exports/.gitkeep

# Any private key that ends up in the repo directory by mistake (SSH,
# TLS, or otherwise) -- shouldn't live here, but excluded as a safety net.
*.pem
